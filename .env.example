# ============================================
# SINEMA Chatbot - Environment Configuration
# ============================================
# Copy this file to .env and update values

# Flask Configuration
SECRET_KEY=your-secret-key-change-in-production
DEBUG=true
FLASK_ENV=development

# ============================================
# LLM CONFIGURATION
# ============================================

USE_API=true

OPENROUTER_API_KEY=your-openrouter-api-key
# Model yang tersedia di OpenRouter:
OPENROUTER_MODEL=openai/gpt-oss-20b:free

# Device untuk inference
# Opsi: "cuda" (GPU) atau "cpu"
DEVICE=cuda

# ============================================
# LLM Generation Parameters
# ============================================
MAX_NEW_TOKENS=2048
TEMPERATURE=0.7
TOP_P=0.9

# ============================================
# RAG Configuration
# ============================================
TOP_K=8
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RELEVANCE_THRESHOLD=0.2

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT=20 per minute

# ============================================
# Database Configuration (MySQL - SINEMA)
# ============================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=siny1585_sinemadb
DB_USERNAME=root
DB_PASSWORD=
