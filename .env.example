# ============================================
# SINEMA Chatbot - Environment Configuration
# ============================================
# Copy this file to .env and update values

# Flask Configuration
SECRET_KEY=sinema-chatbot-dev-key-2025
DEBUG=true
FLASK_ENV=development

# ============================================
# LLM CONFIGURATION
# ============================================

USE_API=true

OPENROUTER_API_KEY=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
# OPENROUTER_API_KEY=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
# Model yang tersedia di OpenRouter:
OPENROUTER_MODEL=openai/gpt-oss-20b:free

# Device untuk inference
# Opsi: "cuda" (GPU) atau "cpu"
DEVICE=cuda

# ============================================
# LLM Generation Parameters
# ============================================
MAX_NEW_TOKENS=2048
TEMPERATURE=0.7
TOP_P=0.9

# ============================================
# RAG Configuration
# ============================================
TOP_K=15
CHUNK_SIZE=800
CHUNK_OVERLAP=200
RELEVANCE_THRESHOLD=0.2

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT=20 per minute

# ============================================
# Database Configuration (MySQL - SINEMA)
# ============================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=siny1585_sinemadb
DB_USERNAME=root
DB_PASSWORD=
