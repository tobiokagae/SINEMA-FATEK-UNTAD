# ============================================
# SINEMA Chatbot - Environment Configuration
# ============================================

# Flask Configuration
SECRET_KEY=sinema-chatbot-dev-key-2025
DEBUG=true
FLASK_ENV=development

# ============================================
# LLM CONFIGURATION
# ============================================

# Multiple API keys for auto-rotation (comma-separated)
# When one key hits rate limit, the system automatically switches to the next
USE_API=true
OPENROUTER_API_KEYS=your-openrouter-api-keys-here

# Fallback: single key (used if OPENROUTER_API_KEYS is not set)

OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=openai/gpt-oss-120b:free
 
# Device untuk inference
# Opsi: "cuda" (GPU) atau "cpu"
DEVICE=cuda

# ============================================
# LLM Generation Parameters
# ============================================
MAX_NEW_TOKENS=2048
TEMPERATURE=0.4
TOP_P=0.9

# ============================================
# RAG Configuration
# ============================================
TOP_K=20
CHUNK_SIZE=1000
CHUNK_OVERLAP=300
RELEVANCE_THRESHOLD=0.2

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT=20 per minute

# ============================================
# Database Configuration (MySQL - SINEMA)
# ============================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=siny1585_sinemadb
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

# ============================================
# Evaluation Dashboard
# ============================================
EVAL_ADMIN_PIN=your_eval_admin_pin
