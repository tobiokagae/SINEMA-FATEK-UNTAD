# ============================================
# SINEMA Chatbot - Environment Configuration
# ============================================

# Flask Configuration
SECRET_KEY=sinema-chatbot-dev-key-2025
DEBUG=true
FLASK_ENV=development

# ============================================
# LLM CONFIGURATION
# ============================================

USE_API=true

OPENROUTER_API_KEY=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
# OPENROUTER_API_KEY=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
# Model yang tersedia di OpenRouter:
OPENROUTER_MODEL=openai/gpt-oss-120b:free
 
# Device untuk inference
# Opsi: "cuda" (GPU) atau "cpu"
DEVICE=cuda

# ============================================
# LLM Generation Parameters
# ============================================
MAX_NEW_TOKENS=2048
TEMPERATURE=0.4
TOP_P=0.9

# ============================================
# RAG Configuration
# ============================================
TOP_K=20
CHUNK_SIZE=1000
CHUNK_OVERLAP=300
RELEVANCE_THRESHOLD=0.3

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT=20 per minute

# ============================================
# Database Configuration (MySQL - SINEMA)
# ============================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=siny1585_sinemadb
DB_USERNAME=root
DB_PASSWORD=
